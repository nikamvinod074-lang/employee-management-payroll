# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database (MySQL). Set USE_SQLITE=True to skip MySQL entirely for a quick
# local trial run (not recommended beyond local development).
# ---------------------------------------------------------------------------
USE_SQLITE=False
DB_NAME=employee_management
DB_USER=root
DB_PASSWORD=server
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Password reset tokens
# ---------------------------------------------------------------------------
# How long a forgot-password token is valid for before it expires.
# Tokens are also strictly one-time-use and are invalidated the moment a
# newer one is issued for the same account (see accounts/models.py).
PASSWORD_RESET_TOKEN_TTL_MIN=30

# ---------------------------------------------------------------------------
# CORS / CSRF (frontend origin)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Company info (shown on payslips)
# ---------------------------------------------------------------------------
COMPANY_NAME=Acme Corporation Pvt. Ltd.
COMPANY_ADDRESS=123 Business Park, Hyderabad, Telangana, India
